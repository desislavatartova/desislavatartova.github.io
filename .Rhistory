############ 5. STANDARDIZE VARIABLES ############
############################################################
# Z-standardize all variables except exclusions
z_std_vars <- function(DT, vars, suffix = "_std") {
for (v in vars) {
mu <- mean(DT[[v]], na.rm = TRUE)
s  <- sd(DT[[v]],   na.rm = TRUE)
if (is.na(s) || s == 0) {
DT[, (paste0(v, suffix)) := NA_real_]
} else {
DT[, (paste0(v, suffix)) := (get(v) - mu) / s]
}
}
invisible(DT)
}
exclude_std <- c("teacher_row_id", "tva_fake","mentor","female","trainer","agrege","contractual",
"initial_training_math","phd","certif_caffa","certif_special_needs",
"private","below_bsc")
vars_std <- setdiff(names(DT), exclude_std)
# only standardize numeric columns
vars_std <- vars_std[sapply(DT[, ..vars_std], is.numeric)]
DT <- z_std_vars(DT, vars_std)
write.dta(DT,paste(DirOutput,"DT_stata.dta",sep=""))
############################################################
############ 3B. BINSCATTER: TVA SHRUNK vs NONSHRUNK #######
############################################################
# Simple binscatter: bin by tva_nonshrunk, plot mean(tva_shrunk) per bin
binscatter <- function(x, y, nbins = 20) {
ok <- is.finite(x) & is.finite(y)
x <- x[ok]; y <- y[ok]
if (length(x) < nbins) return(NULL)
cuts <- quantile(x, probs = seq(0, 1, length.out = nbins + 1), na.rm = TRUE)
# ensure unique cut points
cuts <- unique(cuts)
if (length(cuts) < 3) return(NULL)
bin <- cut(x, breaks = cuts, include.lowest = TRUE)
bx <- tapply(x, bin, mean, na.rm = TRUE)
by <- tapply(y, bin, mean, na.rm = TRUE)
data.frame(bx = as.numeric(bx), by = as.numeric(by))
}
bs <- binscatter(DT$tva_nonshrunk, DT$tva_shrunk, nbins = 20)
if (!is.null(bs)) {
# show in R plot window
lim_xy <- max(abs(c(bs$bx, bs$by)), na.rm = TRUE)
plot(bs$bx, bs$by, pch = 19, col = "black",
xlim = c(-lim_xy, lim_xy), ylim = c(-lim_xy, lim_xy),
xlab = "TVA non-shrunk", ylab = "TVA shrunk",
main = "Binscatter: TVA shrunk vs non-shrunk")
abline(0, 1, col = "blue", lwd = 2, lty = 2)
abline(lm(by ~ bx, data = bs), col = "red", lwd = 2)
png(file.path(DirResults, "binscatter_tva_shrunk_vs_nonshrunk.png"), width = 1000, height = 800)
lim_xy <- max(abs(c(bs$bx, bs$by)), na.rm = TRUE)
plot(bs$bx, bs$by, pch = 19, col = "black",
xlim = c(-lim_xy, lim_xy), ylim = c(-lim_xy, lim_xy),
xlab = "TVA non-shrunk", ylab = "TVA shrunk",
main = "Binscatter: TVA shrunk vs non-shrunk")
abline(0, 1, col = "blue", lwd = 2, lty = 2)
abline(lm(by ~ bx, data = bs), col = "red", lwd = 2)
dev.off()
}
