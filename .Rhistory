geom_vline(data = mean_data,
aes(xintercept = mean_tva, color = status2),
linetype = "dashed",
linewidth = 0.9,
show.legend = FALSE) +
scale_color_manual(
values = c("Ordinary" = "#2c567c", "Disadvantaged" = "#9e2f37"),
labels = c("Ordinary" = "Ordinary",
"Disadvantaged" = "Disadvantaged")
) +
labs(x = "TVA", y = "Density", color = NULL) +
theme_minimal(base_size = 16) +
