axis.text = element_text(color = "black"),
axis.title = element_text(color = "black"),
legend.position = c(0.7, 0.95),
legend.justification = c(0, 1),
legend.background = element_blank(),
legend.key = element_blank(),
legend.text = element_text(size = 14),
plot.margin = margin(10, 60, 10, 10)
)
ggsave(file.path(DirResults, "density_tva_shrunk_by_gender.pdf"),
p2, width = 9, height = 5)
# identify survey items (non-standardized version)
survey_vars <- grep("^(pre_|meo_|eva_)", names(DT), value = TRUE, perl = TRUE)
survey_vars <- survey_vars[!grepl("_std$", survey_vars)]
pre_vars <- grep("^pre", survey_vars, value = TRUE)
meo_vars <- grep("^meo", survey_vars, value = TRUE)
eva_vars <- grep("^eva", survey_vars, value = TRUE)
cat("Number of vars per axis: \n")
length(pre_vars)
length(meo_vars)
length(eva_vars)
## classify survey items as binary vs. 4-point -------------------
vals <- function(x) sort(unique(x[!is.na(x)]))
binary_vars <- survey_vars[sapply(DT[, ..survey_vars], function(x) length(vals(x)) == 2)]
fourpt_vars <- survey_vars[sapply(DT[, ..survey_vars], function(x) {
u <- vals(x); length(u) %in% 3:4 & all(u %in% 1:4)
})]
fourpt_vars <- setdiff(fourpt_vars, binary_vars)
# compute SD for each item
item_stats <- data.table(
variable = fourpt_vars,
sd = sapply(fourpt_vars, function(v) sd(DT[[v]], na.rm = TRUE)),
mean = sapply(fourpt_vars, function(v) mean(DT[[v]], na.rm = TRUE)),
n_valid = sapply(fourpt_vars, function(v) sum(!is.na(DT[[v]])))
)
# sort by SD
item_stats <- item_stats[order(sd)]
item_stats[, rank := .I]
# print summary
cat("Summary of item SDs:\n")
print(summary(item_stats$sd))
# ── 2. Histogram of SDs
p_hist <- ggplot(item_stats, aes(x = sd)) +
geom_histogram(
bins = 30,
fill = "#2c567c",
color = "white",
linewidth = 0.3
) +
labs(
x = "Standard deviation",
y = "Number of items"
) +
theme_minimal(base_size = 16) +
theme(
panel.background = element_rect(fill = "white", color = NA),
plot.background  = element_rect(fill = "white", color = NA),
panel.grid.major = element_line(
color = "#d9d9d9",
linewidth = 0.8,
linetype = "dashed"
),
panel.grid.minor = element_blank(),
axis.line = element_line(color = "black", linewidth = 0.6),
axis.ticks = element_line(color = "black", linewidth = 0.5),
axis.text = element_text(color = "black"),
axis.title = element_text(color = "black"),
plot.margin = margin(10, 20, 10, 10)
)
ggsave(file.path(DirResults, "fig_distr_item_sds_blue.pdf"),p_hist, width = 9, height = 5)
# Simple binscatter: bin by tva_nonshrunk, plot mean(tva_shrunk) per bin
binscatter <- function(x, y, nbins = 20) {
ok <- is.finite(x) & is.finite(y)
x <- x[ok]; y <- y[ok]
if (length(x) < nbins) return(NULL)
cuts <- quantile(x, probs = seq(0, 1, length.out = nbins + 1), na.rm = TRUE)
# ensure unique cut points
cuts <- unique(cuts)
if (length(cuts) < 3) return(NULL)
bin <- cut(x, breaks = cuts, include.lowest = TRUE)
bx <- tapply(x, bin, mean, na.rm = TRUE)
by <- tapply(y, bin, mean, na.rm = TRUE)
data.frame(bx = as.numeric(bx), by = as.numeric(by))
}
bs <- binscatter(DT$tva_shrunk,DT$exp_since_titul, nbins = 20)
if (!is.null(bs)) {
# show in R plot window
lim_xy <- max(abs(c(bs$bx, bs$by)), na.rm = TRUE)
plot(bs$bx, bs$by, pch = 19, col = "black",
# xlim = c(-lim_xy, lim_xy), ylim = c(-lim_xy, lim_xy),
xlim = range(bs$bx, na.rm = TRUE),
ylim = range(bs$by, na.rm = TRUE),
xlab = "Factor score", ylab = "TVA shrunk",
main = "Binscatter: TVA shrunk vs factors")
abline(0, 1, col = "blue", lwd = 2, lty = 2)
abline(lm(by ~ bx, data = bs), col = "red", lwd = 2)
png(file.path(DirResults, "try.png"), width = 1000, height = 800)
}
bs <- binscatter(DT$score_meo1_MR3_std,DT$female, nbins = 20)
if (!is.null(bs)) {
# show in R plot window
lim_xy <- max(abs(c(bs$bx, bs$by)), na.rm = TRUE)
plot(bs$bx, bs$by, pch = 19, col = "black",
# xlim = c(-lim_xy, lim_xy), ylim = c(-lim_xy, lim_xy),
xlim = range(bs$bx, na.rm = TRUE),
ylim = range(bs$by, na.rm = TRUE),
xlab = "Female", ylab = "Factor score",
main = "Binscatter")
abline(0, 1, col = "blue", lwd = 2, lty = 2)
abline(lm(by ~ bx, data = bs), col = "red", lwd = 2)
png(file.path(DirResults, "try.png"), width = 1000, height = 800)
}
